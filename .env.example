# Application
GRIDPULSE_ENV=development
GRIDPULSE_DEMO_MODE=true
GRIDPULSE_LOG_LEVEL=INFO

# Free public-data APIs
EIA_API_KEY=
NASA_FIRMS_MAP_KEY=

# AI providers and model hub
GEMINI_API_KEY=
HF_TOKEN=

# Optional hosted tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=gridpulse-mvp

# Local development defaults; replace with a Neon URL for deployment.
DATABASE_URL=sqlite:///./gridpulse.db

